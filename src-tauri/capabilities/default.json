{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Olko ERP desktop permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://*.olkoerp.com",
      "https://olkoerp.com",
      "https://*.admedia.az",
      "https://admedia.az"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "allow-open-external",
    "allow-native-ping",
    "allow-native-test",
    "allow-native-print",
    "updater:default",
    "process:allow-restart"
  ]
}
