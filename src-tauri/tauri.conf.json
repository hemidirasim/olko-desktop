{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Olko ERP",
  "version": "0.5.14",
  "identifier": "com.olkoerp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Olko ERP",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "transparent": false,
        "shadow": true,
        "minWidth": 1024,
        "minHeight": 700,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Olko ERP"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hemidirasim/olko-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MTZCQ0Q1OUVCMDUyNkQKUldSdFVyQ2UxYndXeVlyV3pYMzA3aUhtSUhzZExxQ1AxSDZnZ0N3QmZDVjRQbklwNi9DVUQzZUcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
