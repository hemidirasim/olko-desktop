{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Olko ERP",
  "version": "0.2.1",
  "identifier": "com.olkoerp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Olko ERP",
        "width": 424,
        "height": 644,
        "resizable": false,
        "decorations": false,
        "center": false,
        "x": 1100,
        "y": 80,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Olko ERP"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hemidirasim/olko-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
